# --- Planner Providers (Vercel AI SDK) ---
ANTHROPIC_API_KEY=
# Vertex AI Express Mode API key (uses GCP billing credits)
GOOGLE_VERTEX_API_KEY=
# Works with either GOOGLE_GENERATIVE_AI_API_KEY or GEMINI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_PLANNER_MODEL=gemini-3.5-flash

# --- Hand-off to Python google-genai Media Worker ---
WORKER_BASE_URL=http://127.0.0.1:8080
WORKER_BEARER_TOKEN=
PLANNER_PORT=8787
