{
  "name": "@napda/planner-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NAPDA planner API and reusable planning library.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/test-node.mjs planning infrastructure integration",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "plan": "tsx src/cli.ts plan",
    "compare": "tsx src/cli.ts compare",
    "submit": "tsx src/cli.ts submit",
    "serve": "tsx src/cli.ts serve"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.108",
    "@ai-sdk/google": "^4.0.126",
    "@ai-sdk/google-vertex": "^5.0.148",
    "ai": "^7.0.181",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
