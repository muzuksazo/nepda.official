  "captions": [
    {
      "start": 0.0,
      "end": 2.55,
      "text": "밤 11시 라면 하나에\n우리가 하는 **미친 짓** 아세요?",
      "pop_badge": "밤 11시 야식",
      "y_pos": 1240,
      "is_cta": false
    },
    {
      "start": 2.55,
      "end": 5.57,
      "text": "배달앱 켜면 **52분 대기**\n배달비만 **4,000원**",
      "pop_badge": "배달 52분",
      "y_pos": 1240,
      "is_cta": false
    },
    {
      "start": 5.57,
      "end": 9.01,
      "text": "직접 끓이려 주방 가면\n**설거지 산더미** · 인덕션 1구",
      "pop_badge": "설거지 산더미",
      "y_pos": 1240,
      "is_cta": false
    },
    {
      "start": 9.01,
      "end": 11.2,
      "text": "라면 **3분** 먹자고\n설거지 **네 개**에",
      "y_pos": 1240,
      "is_cta": false
    },
    {
      "start": 11.2,
      "end": 13.1,
      "text": "**47분**\n**중노동**입니다",
      "pop_badge": "현타 주의",
      "y_pos": 1240,
      "is_cta": false
    },
    {
      "start": 13.36,
      "end": 15.62,
      "text": "그래서 저는 그냥\n**주방을 포기했습니다**",
      "pop_badge": "전환점",
      "y_pos": 1240,
      "is_cta": false
    },
    {
      "start": 15.62,
      "end": 18.28,
      "text": "식탁에서 코드만 꽂고\n**다이얼**을 돌리면",
      "pop_badge": "코드 + 2단 다이얼",
      "y_pos": 1240,
      "is_cta": false
    },
    {
      "start": 18.28,
      "end": 21.15,
      "text": "**스텐 내솥**이 바로\n**팔팔** 끓거든요",
      "pop_badge": "스텐 내솥",
      "y_pos": 1240,
      "is_cta": false
    },
    {
      "start": 21.15,
      "end": 24.65,
      "text": "코드 빼서 **냄비째** 먹고\n스마일 커버 닫고 **쓱 헹구면 끝!**",
      "pop_badge": "스마일 커버",
      "y_pos": 1240,
      "is_cta": false
    },
    {
      "start": 24.65,
      "end": 28.15,
      "text": "만두찜·햇반 중탕도 한 대면\n**배달 52분** 기다릴 시간에",
      "pop_badge": "4-in-1 멀티",
      "y_pos": 1385,
      "is_cta": false
    },
    {
      "start": 28.15,
      "end": 31.2,
      "text": "이미 **다 먹고 누웠습니다**\n댓글에 **'머그팟'** 남기세요",
      "pop_badge": "공구 진행중",
      "y_pos": 1240,
      "is_cta": true
    }
