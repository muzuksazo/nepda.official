# --- Auth Option A: Google AI Studio (MVP / local dev) ---
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# --- Auth Option B: GCP Vertex AI API Key (Express Mode) or Workload Identity (Cloud Run / Vercel OIDC WIF) ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_VERTEX_API_KEY=
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/<GCP_PROJECT_NUMBER>/locations/global/workloadIdentityPools/vercel-napda-pool/providers/vercel-napda-api
# GCP_SERVICE_ACCOUNT_EMAIL=napda-vercel-wif@<GCP_PROJECT_ID>.iam.gserviceaccount.com
# 두 개발자 GCP 크레딧 번갈아(round_robin) 또는 1순위 소진 시 자동 폴백(failover):
# GCP_VERTEX_ROUTING_MODE=round_robin
# GCP_VERTEX_COOLDOWN_SEC=300
# GCP_VERTEX_PROFILES_JSON=[{"name":"dev1","project":"proj-1","location":"global"},{"name":"dev2","project":"proj-2","location":"global"}]

# Optional API auth guard for internal worker `/v1/jobs*` endpoints
API_BEARER_TOKEN=

# --- End-User Google One Tap Auth, Daily Quota & Retention ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SESSION_SECRET=change-this-to-a-random-32byte-secret
SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RETENTION_TTL_DAYS=7
DAILY_RENDER_LIMIT=3
MAX_UPLOAD_FILE_BYTES=104857600
MIN_UPLOAD_TOTAL_SEC=5.0
MAX_UPLOAD_TOTAL_SEC=90.0
PLANNER_BASE_URL=http://127.0.0.1:8787

# --- Models ---
PLANNER_MODEL=gemini-3.5-flash
IMAGE_MODEL=gemini-nano-banana-2.1
VIDEO_MODEL=gemini-omni-flash-preview
TTS_MODEL=gemini-3.8-flash-tts
TTS_DEFAULT_VOICE=Kore
TTS_PROVIDER=inworld
INWORLD_API_KEY=
INWORLD_VOICE_ID=scarlet-mango-0605__gangsangyun
INWORLD_MODEL=inworld-tts-2
INWORLD_SPEAKING_RATE=1.1

# --- Worker & Safety Caps ---
CONCURRENCY=3
MAX_VIDEO_CREDITS_PER_JOB=180
POLL_INTERVAL_SEC=5.0
VIDEO_TIMEOUT_SEC=600.0

# --- Hook video pipeline (backend/hookpipe, see backend/hookpipe/README.md) ---
# HOOK_WORKER_LLM=gemini-4-hydrogen   # B·C 시나리오를 Gemini 로 (비우면 Claude)
# HOOK_A_MODE=template               # A: 템플릿 먼저(없으면 실시간) | realtime
# HOOK_A_TEMPLATES=storage:templates/a   # R2 의 템플릿 경로 (catalog.json + 장면 영상)
# HOOK_WORKER_MODE=auto          # auto: A/B/C workers, then planner-api on failure | off: planner-api only
# HOOK_RENDER_MODE=video_model   # dry_run: no paid calls, writes scenario.json + hook.srt only
# HOOK_MAX_SEC=20
# HOOK_MAX_CLIP_SEC_PER_HOOK=45
# BODY_MAX_SEC=60
# BODY_TARGET_SEC=10                # A·B·C 공용 본편 길이
# BODY_LLM=gemini-4-hydrogen        # 본편 대본·컷 고르기
# FFMPEG_BIN=

# --- Object Storage (local | r2 | s3). r2 와 s3 는 같다: Cloudflare R2 는 S3 호환 API 로 접속한다 ---
STORAGE_BACKEND=local
# STORAGE_BACKEND=r2
# 이름은 R2_… 또는 S3_… 아무거나 (같은 설정)
# R2_BUCKET=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PREFIX=

# --- Paddle Billing (Sandbox) ---
PADDLE_ENVIRONMENT=sandbox
PADDLE_ACCOUNT_EMAIL=dudnjsckrgo@gmail.com
# PADDLE_API_KEY=pdl_sdbx_apikey_...
# PADDLE_CLIENT_TOKEN=test_...
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# PADDLE_PRICE_C30=pri_...
# PADDLE_PRICE_C100=pri_...
# PADDLE_PRICE_C300=pri_...
CREDITS_PER_VIDEO=12
INITIAL_FREE_VIDEOS=1
