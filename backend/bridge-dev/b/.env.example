# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5-5. 비용을 줄이려면 claude-sonnet-5-5
B_MODEL=claude-opus-5-5
# 제품 조사 모델 (기본 claude-sonnet-5-5)
# B_RESEARCH_MODEL=claude-sonnet-5-5

# Inworld TTS (선택): Portal 의 Base64 키 그대로, 목소리 ID
INWORLD_API_KEY=
INWORLD_VOICE_ID=
# INWORLD_MODEL=inworld-tts-2
# INWORLD_RATE=1.1
# 모든 LLM 단계를 한 모델로 (예: gemini-4-hydrogen → Claude API 없이, GEMINI_API_KEY 필요). 켜면 단계별 B_*_MODEL 보다 우선 (예외: B_LLM_KEEP=B_QA_MODEL)
# B_LLM=gemini-4-hydrogen
