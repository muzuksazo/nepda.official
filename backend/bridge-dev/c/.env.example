# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.

# 시나리오 생성 (Claude). --offline 으로 실행하면 필요 없습니다.
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5-5. 비용을 줄이려면 claude-sonnet-5-5
C_MODEL=claude-opus-5-5

# 나레이션 음성 (Inworld TTS). --no-tts 로 실행하면 필요 없습니다.
INWORLD_API_KEY=
C_TTS_VOICE=scarlet-mango-0605__gangsangyun
C_TTS_MODEL=inworld-tts-2

# 결과 파일 위치. 기본값 output (c/ 기준)
OUTPUT_DIR=output

# 자동으로 못 찾을 때만 지정
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.3\blender.exe
# FFMPEG_BIN=
# FFPROBE_BIN=
# 자막 글꼴. 기본값: Windows 는 Malgun Gothic, 그 밖은 Noto Sans CJK KR
# C_FONT=
