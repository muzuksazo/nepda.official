# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.

# 시나리오 생성 (Claude). --offline 으로 실행하면 필요 없습니다.
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5-5. 비용을 줄이려면 claude-sonnet-5-5
C_MODEL=claude-opus-5-5

# 나레이션 음성 (Inworld TTS). --no-tts 로 실행하면 필요 없습니다.
INWORLD_API_KEY=
C_TTS_VOICE=scarlet-mango-0605__gangsangyun
C_TTS_MODEL=inworld-tts-2

# 문제 장면 생성 영상 (Google Gemini Omni, Google Cloud). 비워 두면 Blender 렌더만 씁니다.
# 프로젝트에 결제 계정 연결 + Vertex AI API 사용 설정이 되어 있어야 합니다.
GOOGLE_CLOUD_PROJECT=project-453b367f-b616-4471-aef
# 인증은 둘 중 하나: 서비스 계정 키 파일 경로를 아래에 넣거나, `gcloud auth application-default login` 실행
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\vertex-sa.json
# GOOGLE_CLOUD_LOCATION=us-central1
# Omni: 기본값 gemini-omni-1.2-flash, 해상도 720p (360p · 720p · 1080p · 4k)
# C_OMNI_MODEL=gemini-omni-1.2-flash
# C_OMNI_RESOLUTION=720p
# Veo 를 쓸 때만 (C_PROBLEM_ENGINE=veo). 기본값 veo-3.1-fast-generate-001
# C_VEO_MODEL=veo-3.1-fast-generate-001
# 720p(기본) 또는 1080p
# C_VEO_RESOLUTION=
# auto(기본: 프로젝트가 있으면 생성 모델, 실패하면 blender) · veo · omni(둘 다 실패하면 오류) · blender
# auto 가 쓰는 생성 모델. veo(기본, 무료 체험 계정에서도 됨) 또는 omni(유료 결제 계정 필요, 3~15초)
# C_GENERATOR=veo

# MiniMax(Hailuo) 로 문제 장면을 만들 때만 (C_PROBLEM_ENGINE=minimax 또는 C_GENERATOR=minimax). 키는 여기에만 두고 커밋하지 않습니다
# MINIMAX_API_KEY=
# 기본값 MiniMax-H3 (4~15초). 더 싼 쪽: MiniMax-H3-Highspeed, MiniMax-H3-Lite
# C_MINIMAX_MODEL=MiniMax-H3
# 480P · 768P(기본) · 2K(MiniMax-H3 만)
# C_MINIMAX_RESOLUTION=768P
# C_PROBLEM_ENGINE=auto

# 결과 파일 위치. 기본값 output (c/ 기준)
OUTPUT_DIR=output

# 결과 저장소. local은 로컬 파일, s3는 Cloudflare R2에 결과 업로드.
# 이 파일을 c/.env로 복사한 뒤 s3로 바꾸고 아래 값을 채우세요.
STORAGE_BACKEND=local
# C에서만 공용 환경변수와 다른 저장소를 쓰려면 C_STORAGE_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=shortform-ad-studio/C
S3_URL_EXPIRES_SEC=3600
# S3_ENDPOINT_URL 예: https://<account_id>.r2.cloudflarestorage.com

# 자동으로 못 찾을 때만 지정
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.3\blender.exe
# FFMPEG_BIN=
# FFPROBE_BIN=
# 자막 글꼴. 기본값: Windows 는 Malgun Gothic, 그 밖은 Noto Sans CJK KR
# C_FONT=
