# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.
# 이 작업자는 시나리오(FR-003)만 만듭니다. 영상·나레이션·본편은 backend/hookpipe 가 만듭니다.

# 글 모델: Claude (기본)
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5-5. 비용을 줄이려면 claude-sonnet-5-5
C_MODEL=claude-opus-5-5

# 글 모델: Gemini 를 쓸 때 (--model gemini-4-hydrogen 또는 C_MODEL=gemini-…)
GEMINI_API_KEY=
