# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.

# 시나리오 생성 (Claude). --offline 으로 실행하면 필요 없습니다.
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5-5. 비용을 줄이려면 claude-sonnet-5-5
C_MODEL=claude-opus-5-5

# 나레이션 음성 (Inworld TTS). --no-tts 로 실행하면 필요 없습니다.
INWORLD_API_KEY=
C_TTS_VOICE=scarlet-mango-0605__gangsangyun
C_TTS_MODEL=inworld-tts-2

# 문제 장면 생성 영상 (Google Veo, Vertex AI). 비워 두면 Blender 물리 렌더만 씁니다.
# 프로젝트에 결제 계정 연결 + Vertex AI API 사용 설정이 되어 있어야 합니다.
GOOGLE_CLOUD_PROJECT=
# 인증은 둘 중 하나: 서비스 계정 키 파일 경로를 아래에 넣거나, `gcloud auth application-default login` 실행
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\vertex-sa.json
# GOOGLE_CLOUD_LOCATION=us-central1
# 기본값 veo-3.1-fast-generate-001. 품질 우선이면 veo-3.1-generate-001
# C_VEO_MODEL=veo-3.1-fast-generate-001
# 720p(기본) 또는 1080p
# C_VEO_RESOLUTION=
# auto(기본: 프로젝트가 있으면 veo, 실패하면 blender) · veo(실패하면 오류) · blender
# C_PROBLEM_ENGINE=auto

# 결과 파일 위치. 기본값 output (c/ 기준)
OUTPUT_DIR=output

# 자동으로 못 찾을 때만 지정
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.3\blender.exe
# FFMPEG_BIN=
# FFPROBE_BIN=
# 자막 글꼴. 기본값: Windows 는 Malgun Gothic, 그 밖은 Noto Sans CJK KR
# C_FONT=
