# Google Identity Services (OAuth 2.0 Web Client ID — backend/.env의 GOOGLE_CLIENT_ID와 동일)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 선택: 비워두면 Vite 개발 프록시(/v1 -> http://127.0.0.1:8080)를 통해 동일 출처 쿠키로 통신합니다.
# 별도 오리진 API 서버에 직접 연결할 때만 설정하세요.
# VITE_API_BASE_URL=http://127.0.0.1:8080

# 선택: Paddle Billing 클라이언트 토큰은 기본적으로 백엔드 GET /v1/billing/config에서 받아옵니다.
# 필요 시 프론트 기본값을 덮어쓸 때만 설정하세요.
# VITE_PADDLE_ENVIRONMENT=sandbox
# VITE_PADDLE_CLIENT_TOKEN=test_...
