# 복사해서 .env.local 로 저장합니다 (.env.local 은 Git 에 올라가지 않습니다).

# Google Identity Services (백엔드 GOOGLE_CLIENT_ID와 동일한 OAuth 웹 클라이언트 ID)
VITE_GOOGLE_CLIENT_ID=

# 개발 서버가 /v1, /health 요청을 넘겨 줄 백엔드 주소.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# 기존 VITE_PROXY_TARGET 환경변수도 지원합니다.

# 로컬 개발용 세션 토큰. 운영 빌드에서는 사용하지 않습니다.
# 발급: python backend/bridge-dev/dev_token.py
VITE_DEV_ACCESS_TOKEN=

# 비워 두면 같은 출처의 API 프록시와 로그인 쿠키를 사용합니다.
# 별도 오리진 API 서버에 직접 연결할 때만 설정하세요 (서버에 CORS 허용 필요).
# VITE_API_BASE_URL=http://127.0.0.1:8080

# Paddle Billing 토큰은 기본적으로 GET /v1/billing/config에서 받아옵니다.
# 필요 시 프론트 기본값을 덮어쓸 때만 설정하세요.
# VITE_PADDLE_ENVIRONMENT=sandbox
# VITE_PADDLE_CLIENT_TOKEN=test_...
