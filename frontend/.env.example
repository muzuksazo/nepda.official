# 복사해서 .env.local 로 저장합니다 (.env.local 은 Git 에 올라가지 않습니다).

# 개발 서버(npm run dev)가 /v1, /health 요청을 넘겨 줄 백엔드 주소. 같은 origin 으로 부르므로 CORS 설정이 필요 없습니다.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# 로그인 화면을 연결하기 전까지 쓰는 개발용 세션 토큰.
# 발급: python backend/bridge-dev/dev_token.py  (백엔드의 SESSION_SECRET 과 같은 값으로 만들어야 합니다)
VITE_DEV_ACCESS_TOKEN=

# 프록시 대신 다른 주소의 백엔드를 직접 부를 때만 씁니다 (그 서버에 CORS 허용이 필요합니다).
# VITE_API_BASE_URL=
