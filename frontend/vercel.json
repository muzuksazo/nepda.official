{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run lint && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "has": [{ "type": "host", "value": "napda-staging.vercel.app" }],
      "destination": "https://napda-backend-staging-pwdvuwrqfa-du.a.run.app/v1/:path*"
    },
    {
      "source": "/health",
      "has": [{ "type": "host", "value": "napda-staging.vercel.app" }],
      "destination": "https://napda-backend-staging-pwdvuwrqfa-du.a.run.app/health"
    },
    {
      "source": "/v1/:path*",
      "has": [{ "type": "host", "value": "napda-staging-.*\\.vercel\\.app" }],
      "destination": "https://napda-backend-staging-pwdvuwrqfa-du.a.run.app/v1/:path*"
    },
    {
      "source": "/health",
      "has": [{ "type": "host", "value": "napda-staging-.*\\.vercel\\.app" }],
      "destination": "https://napda-backend-staging-pwdvuwrqfa-du.a.run.app/health"
    },
    { "source": "/v1/:path*", "destination": "https://napda-backend-pwdvuwrqfa-du.a.run.app/v1/:path*" },
    { "source": "/health", "destination": "https://napda-backend-pwdvuwrqfa-du.a.run.app/health" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
