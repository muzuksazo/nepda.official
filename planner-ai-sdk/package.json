{
  "name": "shortform-ad-planner-ai-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-provider (Claude & Gemini) shortform ad planner & A/B tester powered by Vercel AI SDK, handing off specs to the Python google-genai worker.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "plan": "tsx src/cli.ts plan",
    "compare": "tsx src/cli.ts compare",
    "submit": "tsx src/cli.ts submit",
    "serve": "tsx src/cli.ts serve"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.108",
    "@ai-sdk/google": "^4.0.126",
    "ai": "^7.0.181",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
